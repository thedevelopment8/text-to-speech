# Optional local overrides (copy to .env if needed)
# The app works without a .env file.

# Backend: auto | parler | mms
# auto = try Indic Parler-TTS, fall back to MMS Hindi if gated/unavailable
TTS_BACKEND=auto

# Hugging Face model IDs
TTS_MODEL_ID=ai4bharat/indic-parler-tts
TTS_MMS_MODEL_ID=facebook/mms-tts-hin

# Required for gated Indic Parler-TTS (after accepting the model license on HF)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Force device: auto | cuda | cpu
TTS_DEVICE=auto

# Load model at startup (1) or on first generate (0)
TTS_PRELOAD=1

# Max characters per generation chunk (longer scripts are split automatically)
TTS_MAX_CHUNK_CHARS=280
TTS_MAX_TEXT_CHARS=8000

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Upload limit in megabytes
MAX_UPLOAD_MB=25
